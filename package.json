{
  "name": "bailey-wilson-site",
  "private": true,
  "type": "module",
  "description": "Personal site for Bailey Wilson, sales executive and boat broker at Short Marine, Runaway Bay.",
  "scripts": {
    "images": "node scripts/images.mjs",
